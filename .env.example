DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_MUSIC_TEXT_CHANNEL_ID=
DISCORD_BOT_ADMIN_ROLE_ID=
DISCORD_BOT_ADMIN_ROLE_IDS=

LAVALINK_NAME=local
LAVALINK_URL=localhost:2333
LAVALINK_AUTH=youshallnotpass
SEARCH_SOURCE=scsearch
MUSIC_IDLE_DISCONNECT_SECONDS=300
MUSIC_DATABASE_PATH=./data/music.sqlite
CIPHER_URL=http://127.0.0.1:18001
# Optional authenticated YouTube resolver. The session file must be private.
YOUTUBE_COOKIE_FILE=
YTDLP_BINARY=/opt/botsvc/audiobot-tools/venv/bin/yt-dlp

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional YouTube Activity; enable only after its web service and Discord settings are ready.
VIEWER_ENABLED=false
VIEWER_SOCKET=/run/musicmaid-viewer/reader.sock
SPOTIFY_MARKET=DE
SPOTIFY_USER_TOKEN_FILE=/var/lib/audiobot/spotify-user.json

# Enable only after the original-audio checks pass with an authorized Premium account.
SPOTIFY_DIRECT_ENABLED=false
SPOTIFY_DIRECT_AUTH_FILE=/var/lib/audiobot/spotify-direct.json
SPOTIFY_DIRECT_BINARY=/opt/botsvc/audiobot-tools/musicmaid-spotify-stream
